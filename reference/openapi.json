{
  "openapi": "3.0.3",
  "info": {
    "title": "Fincra API",
    "description": "Fincra API reference. Rebuilt from scratch against real service behavior — not migrated from the prior spec.",
    "version": "2.0.0",
    "contact": {
      "name": "Fincra DevRel",
      "email": "devrel@fincra.com"
    }
  },
  "servers": [
    {
      "url": "https://sandboxapi.fincra.com",
      "description": "Sandbox"
    },
    {
      "url": "https://api.fincra.com",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Business",
      "description": "Your business profile — the entity your Fincra integration acts on behalf of."
    }
  ],
  "paths": {
    "/profile/business/me": {
      "get": {
        "operationId": "getBusinessProfile",
        "summary": "Get business profile",
        "description": "Retrieves the authenticated business's profile.",
        "tags": [
          "Business"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Business profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Parent business fetched successfully"
                    },
                    "data": {
                      "$ref": "#/components/schemas/BusinessProfile"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid api-key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayAuthError"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated merchant has no business profile",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": false
                    },
                    "error": {
                      "type": "string",
                      "example": "Merchant account does not have a business tied to it"
                    },
                    "errorType": {
                      "type": "string",
                      "example": "BUSINESS_PROFILE_REQUIRED"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/profile/business": {
      "get": {
        "operationId": "getBusinessesByMerchant",
        "summary": "List businesses",
        "description": "Lists all top-level businesses the authenticated merchant administers. Sub-businesses are excluded. Returns an empty array, not an error, if the merchant has no businesses.",
        "tags": [
          "Business"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Businesses retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Merchant businesses fetched successfully"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BusinessProfile"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid api-key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/profile/business/{businessID}/settings": {
      "patch": {
        "operationId": "updateBusinessSettings",
        "summary": "Update business settings",
        "description": "Updates one or more settings for the specified business. Only fields included in the request are changed; omitted fields retain their existing values. The request must contain at least one supported setting.",
        "tags": [
          "Business"
        ],
        "security": [
          {
            "apiKey": []
          }
        ],
        "parameters": [
          {
            "name": "businessID",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 24,
              "maxLength": 24,
              "example": "64f1c2a4b7d9e30012ab4567"
            },
            "description": "The 24-character `_id` returned by Get business profile. The authenticated merchant must have access to this business."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateBusinessSettingsRequest"
              },
              "example": {
                "callbackURL": "https://example.com/webhooks/fincra",
                "enableWebhook": true,
                "enableWebhookRetry": true,
                "feeBearer": "business",
                "settlementDestination": "wallet",
                "acceptMispayments": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Business settings updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpdateBusinessSettingsResponse"
                },
                "example": {
                  "success": true,
                  "message": "You have successfully updated your business settings",
                  "data": {
                    "_id": "64f1c2a4b7d9e30012ab4567",
                    "name": "Example Business",
                    "email": "operations@example.com",
                    "mobile": "+2348012345678",
                    "status": "enabled",
                    "country": "NG",
                    "isKYCApproved": true,
                    "isBlocked": false,
                    "settings": {
                      "enableWebhook": true,
                      "enableWebhookRetry": true,
                      "callbackURL": "https://example.com/webhooks/fincra",
                      "feeBearer": "business",
                      "settlementDestination": "wallet",
                      "acceptMispayments": true,
                      "overrideBusinessEmail": null
                    },
                    "createdAt": "2025-01-15T09:30:00.000Z",
                    "updatedAt": "2026-09-02T20:15:00.000Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid api-key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayAuthError"
                }
              }
            }
          },
          "403": {
            "description": "The business is blocked or has not completed KYC approval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationError"
                },
                "examples": {
                  "businessBlocked": {
                    "summary": "Business is blocked",
                    "value": {
                      "success": false,
                      "error": "Business has been blocked. Kindly contact support",
                      "errorType": "ACCESS_DENIED"
                    }
                  },
                  "kycNotApproved": {
                    "summary": "Business KYC is not approved",
                    "value": {
                      "success": false,
                      "error": "Business KYC has not been approved. Kindly contact support",
                      "errorType": "ACCESS_DENIED"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Business not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationError"
                },
                "example": {
                  "success": false,
                  "error": "Cannot update setting. Business not found",
                  "errorType": "RESOURCE_NOT_FOUND"
                }
              }
            }
          },
          "422": {
            "description": "The request body is empty or contains an invalid setting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationError"
                },
                "examples": {
                  "emptyBody": {
                    "summary": "No setting supplied",
                    "value": {
                      "success": false,
                      "error": "Cannot continue. No setting provided for update",
                      "errorType": "UNPROCESSABLE_ENTITY"
                    }
                  },
                  "validationFailed": {
                    "summary": "Invalid setting value",
                    "value": {
                      "success": false,
                      "error": "Error occurred during payload validation. overrideBusinessEmail must be a valid email",
                      "errorType": "VALIDATION_FAILED",
                      "errors": [
                        "Error occurred during payload validation. overrideBusinessEmail must be a valid email"
                      ]
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "An unexpected error occurred",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApplicationError"
                },
                "example": {
                  "success": false,
                  "error": "Error occured during operation. We're currently checking why this is happening.",
                  "errorType": "INTERNAL_SERVER_ERROR"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "api-key",
        "description": "Your Sandbox or Production API key, generated from your dashboard."
      }
    },
    "schemas": {
      "GatewayAuthError": {
        "type": "object",
        "required": [
          "message",
          "request_id"
        ],
        "properties": {
          "message": {
            "type": "string",
            "example": "No API key found in request"
          },
          "request_id": {
            "type": "string",
            "example": "9fd0487056e1d44df9c855231b519b1"
          }
        }
      },
      "ApplicationError": {
        "type": "object",
        "required": [
          "success",
          "error",
          "errorType"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ],
            "description": "Indicates that the request failed."
          },
          "error": {
            "type": "string",
            "description": "A human-readable description of the error."
          },
          "errorType": {
            "type": "string",
            "description": "A stable category that identifies the type of error."
          },
          "errors": {
            "description": "Additional validation details, when available.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              {
                "type": "object",
                "additionalProperties": true
              }
            ]
          }
        }
      },
      "UpdateBusinessSettingsRequest": {
        "type": "object",
        "description": "Settings to update. Include at least one property. Omitted properties retain their current values.",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "feeBearer": {
            "type": "string",
            "enum": [
              "customer",
              "business"
            ],
            "description": "Determines who pays applicable transaction fees. `customer` adds the fee to the customer's charge; `business` deducts the fee from the business's proceeds.",
            "example": "business"
          },
          "settlementDestination": {
            "type": "string",
            "enum": [
              "wallet",
              "bank_account"
            ],
            "description": "The default destination for supported settlements. A bank account must be configured before using `bank_account`.",
            "example": "wallet"
          },
          "enableWebhook": {
            "type": "boolean",
            "description": "Whether Fincra sends webhook events to `callbackURL`.",
            "example": true
          },
          "enableWebhookRetry": {
            "type": "boolean",
            "description": "Whether Fincra automatically retries failed webhook deliveries. This setting is disabled by default for new businesses.",
            "example": true
          },
          "callbackURL": {
            "type": "string",
            "minLength": 1,
            "description": "The endpoint that receives webhook events. Supply a non-empty HTTP or HTTPS URL.",
            "example": "https://example.com/webhooks/fincra"
          },
          "acceptMispayments": {
            "type": "boolean",
            "description": "Whether supported Checkout flows accept overpayments and underpayments instead of initiating a reversal.",
            "example": true
          },
          "overrideBusinessEmail": {
            "type": "string",
            "format": "email",
            "description": "An email address to use instead of the business's primary email where this override is supported. The value is stored in lowercase.",
            "example": "finance@example.com"
          },
          "acceptedCurrencies": {
            "type": "array",
            "description": "Requests wallet creation for the supplied currencies. This field is not stored in business settings; verify the resulting wallets separately.",
            "items": {
              "type": "string",
              "example": "NGN"
            },
            "example": [
              "NGN",
              "USD"
            ]
          }
        }
      },
      "UpdateBusinessSettingsResponse": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              true
            ],
            "description": "Indicates that the settings update completed successfully."
          },
          "message": {
            "type": "string",
            "example": "You have successfully updated your business settings"
          },
          "data": {
            "$ref": "#/components/schemas/BusinessProfile"
          }
        }
      },
      "BusinessProfile": {
        "type": "object",
        "description": "Field set is the real API response projection (PUBLIC_BUSINESS_FIELDS), not the full internal business document — several internal-only fields are intentionally excluded.",
        "properties": {
          "_id": {
            "type": "string",
            "description": "Your business ID."
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "mobile": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "enabled",
              "disabled"
            ]
          },
          "logo": {
            "type": "string",
            "nullable": true
          },
          "businessKey": {
            "type": "string"
          },
          "businessType": {
            "type": "string"
          },
          "website": {
            "type": "string"
          },
          "countryCallingCode": {
            "type": "string",
            "nullable": true
          },
          "businessTag": {
            "type": "integer",
            "nullable": true
          },
          "country": {
            "type": "string"
          },
          "isKYCApproved": {
            "type": "boolean"
          },
          "isBlocked": {
            "type": "boolean"
          },
          "isPrincipalBVNWatchlisted": {
            "type": "boolean"
          },
          "emailSettings": {
            "type": "object",
            "properties": {
              "disbursementNotification": {
                "type": "boolean"
              },
              "collectionNotification": {
                "type": "boolean"
              },
              "topupNotification": {
                "type": "boolean"
              },
              "settlementNotification": {
                "type": "boolean"
              },
              "paymentReceiptNotification": {
                "type": "boolean"
              }
            }
          },
          "checkoutSettings": {
            "type": "object",
            "properties": {
              "useBrandLogo": {
                "type": "boolean"
              },
              "buttonTextColor": {
                "type": "string",
                "nullable": true
              },
              "buttonColor": {
                "type": "string",
                "nullable": true
              },
              "fontColor": {
                "type": "string",
                "nullable": true
              },
              "fontFamily": {
                "type": "string",
                "nullable": true
              },
              "backgroundColor": {
                "type": "string",
                "nullable": true
              },
              "backgroundTextColor": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "settlementSettings": {
            "type": "object",
            "nullable": true
          },
          "settings": {
            "type": "object",
            "properties": {
              "enableWebhook": {
                "type": "boolean"
              },
              "enableWebhookRetry": {
                "type": "boolean"
              },
              "callbackURL": {
                "type": "string",
                "nullable": true
              },
              "feeBearer": {
                "type": "string",
                "enum": [
                  "customer",
                  "business"
                ]
              },
              "settlementDestination": {
                "type": "string",
                "enum": [
                  "wallet",
                  "bank_account"
                ]
              },
              "acceptMispayments": {
                "type": "boolean"
              },
              "overrideBusinessEmail": {
                "type": "string",
                "nullable": true
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "security": [
    {
      "apiKey": []
    }
  ]
}